[
  // ── HHKB Type-S Optimised VS Code Shortcuts ──────────────
  // Zero F-keys. Zero arrow keys. Everything reachable without Fn.
  // HHKB Control is at Caps Lock position — Ctrl combos are ergonomic.
  // Backtick is a native HHKB key (top-right) — Ctrl+` works natively.

  // ── Editing ──────────────────────────────────────────────
  // Duplicate line
  {
    "key": "cmd+d",
    "command": "editor.action.copyLinesDownAction",
    "when": "editorTextFocus && !editorHasSelection"
  },
  // Delete line
  {
    "key": "cmd+backspace",
    "command": "editor.action.deleteLines",
    "when": "editorTextFocus"
  },
  // Move line up/down (vim-style J/K instead of arrows)
  {
    "key": "ctrl+shift+k",
    "command": "editor.action.moveLinesUpAction",
    "when": "editorTextFocus"
  },
  {
    "key": "ctrl+shift+j",
    "command": "editor.action.moveLinesDownAction",
    "when": "editorTextFocus"
  },

  // ── Autocomplete & List Navigation (replaces arrow keys) ─
  // Navigate suggestions with Ctrl+J/K instead of Up/Down
  {
    "key": "ctrl+j",
    "command": "selectNextSuggestion",
    "when": "suggestWidgetMultipleSuggestions && suggestWidgetVisible && textInputFocus"
  },
  {
    "key": "ctrl+k",
    "command": "selectPrevSuggestion",
    "when": "suggestWidgetMultipleSuggestions && suggestWidgetVisible && textInputFocus"
  },
  // Navigate quick open / command palette with Ctrl+J/K
  {
    "key": "ctrl+j",
    "command": "workbench.action.quickOpenSelectNext",
    "when": "inQuickOpen"
  },
  {
    "key": "ctrl+k",
    "command": "workbench.action.quickOpenSelectPrevious",
    "when": "inQuickOpen"
  },

  // ── Navigation ───────────────────────────────────────────
  // Go to definition
  {
    "key": "cmd+b",
    "command": "editor.action.revealDefinition",
    "when": "editorTextFocus"
  },
  // Find all references / usages (replaces Alt+F7)
  {
    "key": "ctrl+shift+u",
    "command": "references-view.findReferences",
    "when": "editorTextFocus"
  },
  // Navigate back/forward
  {
    "key": "cmd+[",
    "command": "workbench.action.navigateBack"
  },
  {
    "key": "cmd+]",
    "command": "workbench.action.navigateForward"
  },
  // Go to file (quick open)
  {
    "key": "cmd+p",
    "command": "workbench.action.quickOpen"
  },
  // Go to symbol in file
  {
    "key": "cmd+shift+o",
    "command": "workbench.action.gotoSymbol"
  },

  // ── Refactoring ──────────────────────────────────────────
  // Rename symbol (replaces Shift+F6)
  {
    "key": "ctrl+shift+r",
    "command": "editor.action.rename",
    "when": "editorTextFocus"
  },
  // Quick fix
  {
    "key": "alt+enter",
    "command": "editor.action.quickFix",
    "when": "editorTextFocus"
  },
  // Reformat code
  {
    "key": "cmd+alt+l",
    "command": "editor.action.formatDocument",
    "when": "editorTextFocus"
  },

  // ── Panels & UI ──────────────────────────────────────────
  // Toggle terminal (backtick is native on HHKB top-right)
  {
    "key": "ctrl+`",
    "command": "workbench.action.terminal.toggleTerminal"
  },
  // Toggle sidebar
  {
    "key": "cmd+1",
    "command": "workbench.action.toggleSidebarVisibility"
  },
  // Toggle problems panel
  {
    "key": "cmd+shift+m",
    "command": "workbench.actions.view.problems"
  },
  // Close tab
  {
    "key": "cmd+w",
    "command": "workbench.action.closeActiveEditor"
  },

  // ── Run & Debug (replaces F5/F10/F11) ────────────────────
  // Run without debugging (replaces Ctrl+Shift+F10)
  {
    "key": "cmd+r",
    "command": "workbench.action.debug.run"
  },
  // Start debugging (replaces F5)
  {
    "key": "cmd+shift+d",
    "command": "workbench.action.debug.start",
    "when": "!inDebugMode"
  },
  // Continue debugging (replaces F5 while debugging)
  {
    "key": "cmd+shift+d",
    "command": "workbench.action.debug.continue",
    "when": "inDebugMode"
  },
  // Step over (replaces F10)
  {
    "key": "ctrl+shift+o",
    "command": "workbench.action.debug.stepOver",
    "when": "inDebugMode"
  },
  // Step into (replaces F11)
  {
    "key": "ctrl+shift+i",
    "command": "workbench.action.debug.stepInto",
    "when": "inDebugMode"
  },
  // Step out (replaces Shift+F11)
  {
    "key": "ctrl+shift+t",
    "command": "workbench.action.debug.stepOut",
    "when": "inDebugMode"
  },
  // Stop debugging (replaces Shift+F5)
  {
    "key": "cmd+shift+q",
    "command": "workbench.action.debug.stop",
    "when": "inDebugMode"
  },
  // Toggle breakpoint
  {
    "key": "cmd+shift+b",
    "command": "editor.debug.action.toggleBreakpoint",
    "when": "editorTextFocus"
  }
]
